# Settings for the agentic-engineer mode (copy to .env.pdi and fill in; never commit it).
# Used by ./pdi.sh (docker compose project "barqpdi", ports 18000/15432/16379/16333).
# Only names are listed here; every value is a placeholder.
BIND_IP=127.0.0.1
ENVIRONMENT=development
API_PORT=18000
POSTGRES_PASSWORD=<set-me>
REDIS_PASSWORD=<set-me>
WEBHOOK_AUTH_TOKEN=<set-me>
WEBHOOK_OAUTH_CLIENT_ID=barq-servicenow
WEBHOOK_OAUTH_CLIENT_SECRET=<set-me>
WEBHOOK_OAUTH_SIGNING_KEY=<32+ random bytes>
OPERATOR_CLIENT_ID=barq-operator
OPERATOR_ROLES=["operator","approver"]
SERVICENOW_INSTANCE_URL=https://<your-instance>.service-now.com
SERVICENOW_CLIENT_ID=<oauth-client-id>
SERVICENOW_CLIENT_SECRET=<oauth-client-secret>
SERVICENOW_USERNAME=<integration-user>
SERVICENOW_PASSWORD=<integration-password>
SERVICENOW_KB_ID=<kb_knowledge_base sys_id>
SERVICENOW_KB_USERNAME=<kb-publisher-user>
SERVICENOW_KB_PASSWORD=<set-me>
# The engineer loop (src/agent/engineer) instead of the fixed LangGraph pipeline
AGENT_GRAPH_BACKEND=engineer
AGENT_CHECKPOINTER_BACKEND=postgres
AGENT_AUTONOMY_LEVEL=autonomous
AGENT_WRITE_BACK_ENABLED=true
ENABLE_SEMANTIC_CACHE=true
# Model access: a LiteLLM proxy, with an optional own Google AI Studio key tried first
LITELLM_BASE_URL=<proxy-url>
LITELLM_API_KEY=<set-me>
GOOGLE_AI_STUDIO_KEY=<optional>
AGENT_LLM_OWN_KEY_FIRST=false
AGENT_LLM_MODEL=gemini/gemini-3.5-flash
# Tracing (Langfuse). Leave the keys empty to turn tracing off.
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
