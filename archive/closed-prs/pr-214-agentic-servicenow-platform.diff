+def _session_row() -> ChatSession:
+    return ChatSession(
+        id=uuid4(),
+        operator_subject=OPERATOR_SUBJECT,
+        secret_hash=hashlib.sha256(CHAT_SECRET.encode()).hexdigest(),
+        created_at=_now(),
+    )
