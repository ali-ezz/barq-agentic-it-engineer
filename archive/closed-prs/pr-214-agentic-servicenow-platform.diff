+def _conversation_row(session_id: UUID) -> ChatConversation:
+    return ChatConversation(
+        id=uuid4(),
+        session_id=session_id,
+        operator_subject=OPERATOR_SUBJECT,
+        title="New conversation",
+        created_at=_now(),
+        updated_at=_now(),
+    )
